diff --git a/osfmk/arm/machine_routines_common.c b/osfmk/arm/machine_routines_common.c
--- a/osfmk/arm/machine_routines_common.c
+++ b/osfmk/arm/machine_routines_common.c
@@ -1283,6 +1283,21 @@
 unsigned int
 ml_wait_max_cpus(void)
 {
+#if defined(SWEET)
+	/*
+	 * SWEET/POLARIS bring-up currently runs on the boot CPU only: the
+	 * secondary CPUs are never started (PSCI CPU_ON does not complete on
+	 * this SoC), so nothing would ever call ml_set_max_cpus() to release
+	 * this wait. Treat the maximum as reached and let the single-CPU boot
+	 * proceed; SMP bring-up is tracked separately.
+	 */
+	if (max_cpus_initialized != MAX_CPUS_SET) {
+		kprintf("SWEET: ml_wait_max_cpus: single-CPU boot, not waiting for %u CPUs\n",
+		    machine_info.max_cpus);
+		ml_set_max_cpus(machine_info.max_cpus);
+	}
+	return machine_info.max_cpus;
+#else
 	assert(lockdown_done);
 	lck_mtx_lock(&max_cpus_lock);
 	while (max_cpus_initialized != MAX_CPUS_SET) {
@@ -1291,6 +1306,7 @@
 	}
 	lck_mtx_unlock(&max_cpus_lock);
 	return machine_info.max_cpus;
+#endif
 }
 
 void
