diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -873,6 +873,22 @@
 	}
 	printf("%s\n", line);
 
+	/*
+	 * Print the task's mapped ranges so the recovered pc/lr/bt addresses can
+	 * be attributed to dyld, the main executable or the shared cache.
+	 */
+	{
+		vm_map_t map = current_map();
+		vm_map_entry_t entry = vm_map_first_entry(map);
+		vm_map_lock_read(map);
+		for (int i = 0; i < 40 && entry != vm_map_to_entry(map); i++, entry = entry->vme_next) {
+			printf("CRASHMAP %s %d 0x%llx-0x%llx prot %d/%d tag %d\n", name, i,
+			    (uint64_t)entry->vme_start, (uint64_t)entry->vme_end,
+			    entry->protection, entry->max_protection, (int)VME_ALIAS(entry));
+		}
+		vm_map_unlock_read(map);
+	}
+
 	if (sig == 11 || sig == 10) {
 		/* Which mapping the faulting address is in, or which two it falls between. */
