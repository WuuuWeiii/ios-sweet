@@ -2218,11 +2218,15 @@
 	case 2:
 		/* set cthread */
 		platform_syscall_kprintf("set cthread self.\n");
+		printf("SWEET TSD: platform_syscall set cthread 0x%llx\n",
+		    (uint64_t)get_saved_state_reg(state, 0));
 		thread_set_cthread_self(get_saved_state_reg(state, 0));
 		break;
 	case 3:
 		/* get cthread */
 		platform_syscall_kprintf("get cthread self.\n");
+		printf("SWEET TSD: platform_syscall get cthread -> 0x%llx\n",
+		    (uint64_t)thread_get_cthread_self());
 		set_saved_state_reg(state, 0, thread_get_cthread_self());
 		break;
 	case 0: /* I-Cache flush (removed) */
