diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -27,7 +27,7 @@
 
 /* SMCCC 1.0: x0 is the signed PSCI result; do not assume x1-x17 survive. */
 static int32_t
-sweet_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
+sweet_psci_cpu_on_smc(uint64_t target, uint64_t entry, uint64_t context)
 {
 	register uint64_t x0 __asm__("x0") = 0xC4000003ULL;
 	register uint64_t x1 __asm__("x1") = target;
@@ -37,6 +37,39 @@
 	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
 	    "x14", "x15", "x16", "x17", "cc", "memory");
 	return (int32_t)x0;
+}
+
+static int32_t
+sweet_psci_cpu_on_hvc(uint64_t target, uint64_t entry, uint64_t context)
+{
+	register uint64_t x0 __asm__("x0") = 0xC4000003ULL;
+	register uint64_t x1 __asm__("x1") = target;
+	register uint64_t x2 __asm__("x2") = entry;
+	register uint64_t x3 __asm__("x3") = context;
+	__asm__ volatile("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+/* boot-arg sweet_psci=smc|hvc; SDM845 uses SMC, QEMU virt needs HVC. */
+static bool
+sweet_psci_use_hvc(void)
+{
+	char conduit[16] = {};
+	if (PE_parse_boot_argn("sweet_psci", conduit, sizeof(conduit))) {
+		return strncmp(conduit, "hvc", 3) == 0;
+	}
+	return false;
+}
+
+static int32_t
+sweet_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
+{
+	if (sweet_psci_use_hvc()) {
+		return sweet_psci_cpu_on_hvc(target, entry, context);
+	}
+	return sweet_psci_cpu_on_smc(target, entry, context);
 }
 
 class SweetCPU : public IOCPU {
