diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1846,6 +1846,17 @@
 	int create_corpse = FALSE;
 
 	if (p->p_crash_behavior != 0 || p == initproc) {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		/*
+		 * initproc panics inside proc_handle_critical_exit(), so log now:
+		 * the 0109 instrumentation after this block never runs for launchd.
+		 */
+		if (p == initproc) {
+			extern void sweet_crash_log(const char *, int, int, uint64_t, uint64_t);
+			sweet_crash_log(p->p_comm, proc_getpid(p), WTERMSIG(rv),
+			    ((uint64_t)ut->uu_exception << 32) | (uint32_t)ut->uu_code, ut->uu_subcode);
+		}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
 		proc_handle_critical_exit(p, rv);
 	}
 
