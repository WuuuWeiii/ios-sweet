+++ b/iokit/Kernel/arm/SweetScaler.cpp
@@ -0,0 +1,62 @@
+/*
+ * SWEET: stub AppleM2ScalerCSCDriver.
+ *
+ * QuartzCore (through IOSurfaceAccelerator) waits for this IOService before
+ * the window server sets up its renderer; the real hardware block does not
+ * exist here.  Publish a minimal service (and a user client class) so the
+ * match succeeds; the CPU fallback in CoreAnimation then does the scaling.
+ * Honours boot-arg sweetscaler=0 to disable.
+ */
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <pexpert/pexpert.h>
+
+class AppleM2ScalerUserClient;
+
+class AppleM2ScalerCSCDriver : public IOService {
+	OSDeclareDefaultStructors(AppleM2ScalerCSCDriver);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCDriver, IOService);
+
+class AppleM2ScalerUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleM2ScalerUserClient);
+public:
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleM2ScalerUserClient, IOUserClient);
+
+bool
+AppleM2ScalerCSCDriver::start(IOService *provider)
+{
+	uint32_t enabled = 1;
+
+	PE_parse_boot_argn("sweetscaler", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return false;
+	}
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleM2ScalerUserClient");
+	registerService();
+	IOLog("SWEET SCALER: AppleM2ScalerCSCDriver stub published\n");
+	return true;
+}
+
+IOReturn
+AppleM2ScalerUserClient::externalMethod(__unused uint32_t selector,
+    __unused IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch,
+    __unused OSObject *target, __unused void *reference)
+{
+	IOLog("SWEET SCALER: external method %u\n", selector);
+	return kIOReturnUnsupported;
+}
+#endif /* SWEET */
